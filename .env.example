# Copy this file to .env and fill in real values. Never commit the real .env file.

# newsdata.io free-tier API key: https://newsdata.io/
NEWSDATA_API_KEY=your_newsdataio_key_here

# Path to Google service account JSON (recommended over OAuth for a headless/scheduled pipeline)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# Instagram Graph API (Instagram Login flow - graph.instagram.com, no Facebook Page needed)
# Get IG_USER_ID from: https://graph.instagram.com/v21.0/me?fields=id,username&access_token=...
IG_ACCESS_TOKEN=your_instagram_access_token_here
IG_USER_ID=your_instagram_numeric_user_id_here

# scripts/swipe.py has two backends. Pick ONE.
#
# Option A (recommended) — Apify managed scraper. Zero rate-limit babysitting.
# Sign up at apify.com (free $5 credit ~ 3300 posts, then ~$0.0015/post).
# Settings → Integrations → API Tokens → copy token here.
APIFY_TOKEN=your_apify_api_token_here
# Optional: force backend regardless of tokens present. Values: apify | instaloader
# SWIPE_BACKEND=apify
#
# Option B — Instaloader with a burner Instagram account. Free but fragile.
# Setup (do once):
#   1. Create a throwaway IG account in the app (verify email, follow ~30 accts)
#   2. Wait 24h, then: instaloader --login=<burner_username>
#      (enter password when prompted — saves an encrypted session file)
#   3. Set IG_SWIPE_USER below (no password — session is cached on disk)
IG_SWIPE_USER=your_burner_ig_handle_here
